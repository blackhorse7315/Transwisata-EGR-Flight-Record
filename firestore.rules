rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAdmin() { return request.auth != null && request.auth.token.email == 'transwisataprimaops@gmail.com' && request.auth.token.email_verified == true; }
  match /publicData/fleet { allow read: if true; allow write: if isAdmin(); }
  match /privateSettings/emailReminder { allow read, write: if isAdmin(); }
  match /{document=**} { allow read, write: if false; }
 }
}